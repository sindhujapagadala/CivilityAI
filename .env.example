# CivilityAI Environment Configuration

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# Model & Inference Settings
MODEL_BACKEND=transformer
TRANSFORMER_MODEL_PATH=distilbert-base-uncased
MAX_SEQUENCE_LENGTH=128
INFERENCE_BATCH_SIZE=32
DEVICE_PREFERENCE=auto

# Moderation Policy Thresholds
ALLOW_RISK_CEILING=0.30
REVIEW_RISK_CEILING=0.75

# Category Risk Weights (must sum to 1.0)
WEIGHT_THREATENING_LANGUAGE=0.28
WEIGHT_SEVERE_ABUSE=0.25
WEIGHT_IDENTITY_ATTACK=0.22
WEIGHT_PERSONAL_INSULT=0.12
WEIGHT_OBSCENE_LANGUAGE=0.08
WEIGHT_GENERAL_TOXICITY=0.05

# Database Persistence
# For local SQLite development (default):
DATABASE_URL=sqlite:///./civility_moderation.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://civility_admin:secure_password@localhost:5432/civility_db

# Frontend Settings
VITE_API_BASE_URL=http://127.0.0.1:8000
